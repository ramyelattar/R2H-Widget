<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/icon_pack_launcher"
        android:label="@string/icon_pack_name"
        android:supportsRtl="true"
        android:theme="@style/IconPackTheme">
        <activity
            android:name=".IconPackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <!-- Nothing Launcher discovers external icon packs through its
                 launcher-activity inventory. These companion entries are
                 intentionally visible in the app drawer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Matches the legacy launcher-theme contract used by the
                 working icon pack on the target Nothing device. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.fede.launcher.THEME_ICONPACK" />
            </intent-filter>
            <!-- Keep the combined legacy contract used by the reference
                 package as well; some launchers resolve the theme through
                 this multi-action/default filter. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
            </intent-filter>
            <intent-filter>
                <action android:name="ch.deletescape.lawnchair.ICONPACK" />
                <category android:name="ch.deletescape.lawnchair.PICK_ICON" />
            </intent-filter>
        </activity>
    </application>
</manifest>
