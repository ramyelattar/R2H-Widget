<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_music"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/music_album_art"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginEnd="14dp"
            android:background="#221F29"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_music_note" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Music Player"
                android:textColor="#F7F5FB"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Nothing playing"
                android:textColor="#A7A4B5"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/music_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="9dp"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#4A4656"
                android:progressTint="#A78BFA" />

            <LinearLayout
                android:id="@+id/music_time_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="0:00"
                    android:textColor="#8B8798"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/music_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="--:--"
                    android:textColor="#8B8798"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/music_controls"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/music_previous"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="|◀"
                    android:textColor="#F7F5FB"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/music_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_widget_music_play"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F7F5FB"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/music_next"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="▶|"
                    android:textColor="#F7F5FB"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
